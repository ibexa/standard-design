<?xml version="1.0"?>
<phpunit backupGlobals="false" bootstrap="vendor/autoload.php" beStrictAboutTestsThatDoNotTestAnything="true" colors="true" failOnWarning="true" failOnNotice="true" cacheDirectory=".phpunit.cache" backupStaticProperties="false" displayDetailsOnTestsThatTriggerDeprecations="true" failOnDeprecation="true">
  <php>
    <ini name="error_reporting" value="-1"/>
  </php>
  <testsuites>
    <testsuite name="bundle">
      <directory>tests/bundle</directory>
    </testsuite>
  </testsuites>
  <source baseline="phpunit.baseline.xml" ignoreIndirectDeprecations="false" ignoreSuppressionOfDeprecations="true">
    <include>
      <directory>src/bundle</directory>
      <directory>src/lib</directory>
      <directory>src/contracts</directory>
    </include>
  </source>
</phpunit>
